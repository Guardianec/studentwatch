# Django читає .env з кореня проєкту. Значення порожні до налаштування.
POSTUP_MODE=development
DJANGO_SECRET_KEY=
POSTUP_ALLOWED_HOSTS=
POSTUP_TRUSTED_ORIGINS=
POSTUP_TRUSTED_PROXY_IPS=

# POSTUP_DATABASE_URL має пріоритет. Без URL та імені бази SQLite доступна в development.
POSTUP_DATABASE_URL=
POSTUP_DB_NAME=
POSTUP_DB_USER=
POSTUP_DB_PASSWORD=
POSTUP_DB_HOST=127.0.0.1
POSTUP_DB_PORT=5432
POSTUP_DB_SSLMODE=

# Vite використовує це для локального проксі /api/.
POSTUP_DEV_API_ORIGIN=http://127.0.0.1:8000
# Адреса учнівського сайту, яку Windows-збірка додає в запрошення.
VITE_STUDENT_ORIGIN=http://127.0.0.1:1420
# POSTUP_API_ORIGIN для Tauri задається у середовищі процесу збірки.
